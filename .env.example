NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=sip_session
SESSION_TTL_HOURS=12
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Generate a separate key with the command above; never reuse APP_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_invoice_pro
DB_USER=sip_app
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-root-password
# Optional comma-separated allowlist of platform administrator account emails.
PLATFORM_ADMIN_EMAILS=
